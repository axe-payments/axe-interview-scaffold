# Copy this file to `.env` and paste in the values you were given at the start of the
# interview:  cp .env.example .env

# The Vapi API key — used to place calls. (Required.)
VAPI_API_KEY=

# ngrok auth token — lets the app open a public tunnel so the call transcript is sent back
# and pretty-printed in the logs. Optional: leave blank and calls still work, you just
# won't see the transcript. (`docker compose up` starts the tunnel for you.)
NGROK_AUTHTOKEN=
