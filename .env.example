# Copy this file to `.env` and fill in the values you are given at the start of
# the interview:  cp .env.example .env

# --- Vapi credentials (provided to you) ---
VAPI_API_KEY=
VAPI_ASSISTANT_ID_1=
VAPI_PHONE_NUMBER_ID_1=
VAPI_ASSISTANT_ID_2=
VAPI_PHONE_NUMBER_ID_2=

# --- Demo target ---
# The phone the demo call should ring. Put YOUR phone here, E.164 format.
DEMO_TARGET_PHONE=+14155551234

# --- Database ---
# The default below works as-is inside Docker Compose. Only set this if you run
# the app outside Docker.
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/interview
